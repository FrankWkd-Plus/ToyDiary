    "@imgly/background-removal": "^1.7.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "tesseract.js": "^7.0.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
